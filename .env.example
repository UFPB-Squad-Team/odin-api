# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"
DATABASE_NAME="odin_db"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=info            # debug | info | warning | error

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Lista de origens permitidas, separadas por vírgula.
# Produção: use apenas os domínios reais, sem wildcard.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ─── Pagination ───────────────────────────────────────────────────────────────
MAX_PAGE_SIZE=500
MAX_OFFSET_RECORDS=50000
USE_ESTIMATED_TOTAL=true

# ─── Aggregation Cache (in-memory, TTL) ───────────────────────────────────────
AGGREGATION_CACHE_TTL_SECONDS=300    # TTL em segundos das agregações em cache
AGGREGATION_CACHE_MAX_KEYS=512       # Máximo de chaves na cache de agregações

# ─── Gunicorn (Production) ────────────────────────────────────────────────────
WEB_CONCURRENCY=4         # Number of worker processes
GUNICORN_TIMEOUT=120      # Worker timeout in seconds
MAX_REQUESTS=1000         # Requests before worker restart (memory leak protection)
